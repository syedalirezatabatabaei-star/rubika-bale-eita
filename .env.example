# GoOmni 2.4.1 - Sepehr deployment
# Copy this file to .env and replace every CHANGE_ME value.
# The API listens on container port 3000 and is published on host 127.0.0.1:1598.
APP_IMAGE=docker.io/mimalef70/goomni:v2.4.1
APP_PORT=1598
APP_HOST=0.0.0.0

# Required secrets. Generate a 32-byte base64 key with:
# openssl rand -base64 32
APP_BASIC_AUTH=admin:CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
APP_MASTER_KEY=CHANGE_ME_BASE64_32_BYTE_KEY

# Keep the admin UI enabled; it is localhost-only on the host.
APP_UI_ENABLED=true
APP_UI_PUBLIC_ORIGIN=
APP_BASE_PATH=

# Persistent storage. Do not change the volume name on an existing installation.
APP_DATA_VOLUME=goomni-data
APP_DATABASE=/app/storages/goomni.db
APP_MEDIA_ROOT=/app/storages/media
APP_MAX_MEDIA_BYTES=67108864

# Providers: all three are enabled.
# Bale is enabled by default in GoOmni; there is no BALE_ENABLED switch.
EITAA_ENABLED=true
RUBIKA_ENABLED=true

# Bale native endpoints and client identity.
BALE_GRPC_ENDPOINT=https://next-ws.bale.ai
BALE_WS_ENDPOINT=wss://next-ws.bale.ai/ws/
BALE_APP_ID=0
BALE_API_KEY=
BALE_API_VERSION=173855

# Eitaa native adapter.
EITAA_ENDPOINT=https://hasan.eitaa.ir/eitaa/
EITAA_UPLOAD_ENDPOINT=https://alzheimer.eitaa.com/eitaa/
EITAA_DOWNLOAD_ENDPOINT=https://mohsen.eitaa.com/eitaa/
EITAA_API_ID=2496
EITAA_API_HASH=8da85b0d5bfe62527e5b244c209159c3
EITAA_POLL_INTERVAL=5s

# Rubika discovery. Leave overrides empty unless your provider environment requires them.
RUBIKA_DISCOVERY_ENDPOINT=https://getdcmess.iranlms.ir/
RUBIKA_API_ENDPOINT=
RUBIKA_SOCKET_ENDPOINT=

# Worker / queue bounds.
APP_SEND_WORKERS=4
APP_WEBHOOK_WORKERS=8
APP_RECONNECT_WORKERS=4
APP_MEDIA_WORKERS=4
APP_QUEUE_LIMIT=1000
APP_CONNECTION_QUEUE_LIMIT=100

# Optional global webhook. Keep empty unless you configure a trusted HTTPS endpoint and secret.
APP_WEBHOOK=
APP_WEBHOOK_SECRET=
APP_WEBHOOK_DEVICE_MERGE_GLOBAL=false

# Optional outbound proxy.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,::1,host.docker.internal,goomni,panel_sepehr
